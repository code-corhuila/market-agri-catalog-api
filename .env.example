# market-agri-catalog-api — every variable this repository reads.
# Copy to .env (ignored by git) for a local run. Placeholders only: never commit real values.

# Read by application.yml: HTTP port inside the container
PORT=8080

# Arrive with their use cases (not read yet):
#   C3  JWT_PUBLIC_KEY=<-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY----->   (only the public key)
#   C4  DATABASE_URL=jdbc:postgresql://postgres:5432/<database>   DATABASE_USER=catalog_app   DATABASE_PASSWORD=<password>

# Read by deploy/compose.yml (from the market-agri-infra env file)
ENV=<dev|qa|prod>
